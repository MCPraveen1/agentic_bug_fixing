OPENAI_API_KEY=replace_with_your_key
OPENAI_MODEL=gpt-4o-mini
# Required: replace the suffix with the 64-character digest from local `docker image inspect` RepoDigests.
# The placeholder is deliberately invalid; floating tags are rejected by the runner.
BUGFIX_DOCKER_IMAGE=python:3.12-slim@sha256:REPLACE_WITH_LOCALLY_VERIFIED_REPODIGEST
